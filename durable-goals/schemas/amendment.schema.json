{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://durable-goals.dev/schemas/amendment.schema.json",
  "title": "Durable Goals Amendment v1",
  "type": "object",
  "required": ["schema", "goal_id", "revision", "recorded_at", "authority", "operations", "activation_mode"],
  "properties": {
    "schema": {"const": "durable-goals.amendment/v1"},
    "goal_id": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 2},
    "recorded_at": {"type": "string", "format": "date-time"},
    "authority": {"type": "string", "minLength": 1},
    "reason": {"type": "string"},
    "activation_mode": {"type": "string", "minLength": 1},
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["op", "path"],
        "properties": {
          "op": {"enum": ["set", "remove"]},
          "path": {"type": "string", "pattern": "^/.+"},
          "value": {},
          "expect": {}
        }
      }
    }
  }
}
