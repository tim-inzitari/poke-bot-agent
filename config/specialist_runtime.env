# Canonical host/runtime configuration for the sequential specialist trainer.
#
# Specialist-specific checkpoints, datasets, heads, gates, and numerical
# training arguments belong only in ops/specialist_runtime_registry_v1.json.
# Change POKEBOT_ACTIVE_SPECIALIST to select a different registry entry.

POKEBOT_ACTIVE_SPECIALIST=dragapult-dusknoir
POKEBOT_SPECIALIST_RUNTIME_ROOT=/home/inzi/poke-bot-agent-deployments/pure-rl-resident-v41-specialist-matchup-runtime
PYTHONPATH=/home/inzi/poke-bot-agent-deployments/pure-rl-resident-v41-specialist-matchup-runtime

PYTHONUNBUFFERED=1
POKEBOT_TRAINING_SAFETY_VERSION=20260717
POKEBOT_TRAINING_ARM_FILE=/home/inzi/poke-bot-agent/outputs/state/TRAINING_ARMED

PURE_RL_DECISION_CONTEXT=history
PURE_RL_TEMPORAL_LAYERS=1
PURE_RL_MAX_CONTEXT=320
PURE_RL_TEMPORAL_POS=rope
POKEBOT_EXPANDED_HEADS_ENABLED=1
POKEBOT_LIVE_POOL=0

POKEBOT_WORKER_RECYCLE_GAMES=256
WORKER_RECYCLE_GAMES=256
POKEBOT_MULTI_ENV=1
POKEBOT_MULTI_ENV_PER_WORKER=4
POKEBOT_LIBCG_PATH=/home/inzi/poke-bot-agent/outputs/engines/libcg_hidden_inzi_v1.so
POKEBOT_EXPECTED_LIBCG_SHA256=ffd89bf923525a3e6feb5e6201e96a866c0f456895499ed5c4a566303caae67c

PURE_RL_SELF_PLAY_FRAC=0.125
