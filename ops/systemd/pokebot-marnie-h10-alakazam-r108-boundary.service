[Unit]
Description=Activate H10 Alakazam in Marnie practice and holdout at iter-1 boundary
After=pokebot-final-format-marnie-r104-h10-rl.service

[Service]
Type=oneshot
WorkingDirectory=/home/inzi/poke-bot-agent-deployments/final-format-marnie-h10-r104
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/inzi/miniconda3/envs/poke-bot-agent/bin/python -u /home/inzi/poke-bot-agent/scripts/activate_marnie_h10_alakazam_at_boundary.py
TimeoutStartSec=infinity
StandardOutput=append:/home/inzi/poke-bot-agent/outputs/final_format_marnie_r104/logs/h10_alakazam_r108_boundary.log
StandardError=append:/home/inzi/poke-bot-agent/outputs/final_format_marnie_r104/logs/h10_alakazam_r108_boundary.log

[Install]
WantedBy=default.target
