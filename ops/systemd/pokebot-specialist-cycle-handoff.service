[Unit]
Description=Continue to the next unfinished Pokemon specialist
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=oneshot
WorkingDirectory=/home/inzi/poke-bot-agent-deployments/specialist-handoff-current
EnvironmentFile=/home/inzi/.config/pokebot/specialist_runtime.env
Environment=PYTHONUNBUFFERED=1
ExecStartPre=/usr/bin/test -s /home/inzi/poke-bot-agent-deployments/specialist-handoff-current/ops/specialist_cycle_handoff_v1.json
# EnvironmentFile intentionally retains the live specialist selector while the
# boundary is running. Pin PYTHONPATH at exec time because EnvironmentFile
# values override Environment= and may still name the outgoing V5 runtime.
ExecStart=/usr/bin/env PYTHONPATH=/home/inzi/poke-bot-agent-deployments/specialist-handoff-current /home/inzi/miniconda3/envs/poke-bot-agent/bin/python -u scripts/run_specialist_cycle_handoff.py --contract /home/inzi/poke-bot-agent-deployments/specialist-handoff-current/ops/specialist_cycle_handoff_v1.json
Restart=on-failure
RestartSec=60
TimeoutStartSec=36h
TimeoutStopSec=90
KillMode=control-group
LimitNOFILE=16384
MemoryHigh=96G
MemoryMax=112G
MemorySwapMax=0
OOMPolicy=stop
StandardOutput=append:/home/inzi/poke-bot-agent/outputs/logs/specialist-cycle-handoff.log
StandardError=append:/home/inzi/poke-bot-agent/outputs/logs/specialist-cycle-handoff.log
