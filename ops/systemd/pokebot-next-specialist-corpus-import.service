[Unit]
Description=Import the checksum-bound one-ahead specialist corpus
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=%h/.config/pokebot/next_specialist_prestage.env
WorkingDirectory=/home/inzi/poke-bot-agent
ExecStart=/home/inzi/poke-bot-agent/scripts/poll_and_import_prestaged_specialist_corpus.sh
TimeoutStartSec=2h

[Install]
WantedBy=default.target
