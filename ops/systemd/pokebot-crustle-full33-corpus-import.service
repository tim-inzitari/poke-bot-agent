[Unit]
Description=Import checksum-bound Crustle full33 v2 guide corpus without touching runtime
After=network-online.target
Wants=network-online.target
ConditionPathExists=!/home/inzi/poke-bot-agent/outputs/state/crustle-prestage-corpus-import-v2.json

[Service]
Type=oneshot
WorkingDirectory=/home/inzi/poke-bot-agent
ExecCondition=/usr/bin/ssh -o BatchMode=yes -o ConnectTimeout=5 admin@192.168.1.143 /usr/bin/test -s /mnt/Main/main/poke-bot-agent/archive/crustle-guide-corpus-family-full33-v2/CRUSTLE_GUIDE_CORPUS_VALIDATED.json
ExecStart=/home/inzi/miniconda3/envs/poke-bot-agent/bin/python /home/inzi/poke-bot-agent/scripts/import_prestaged_specialist_corpus.py --host admin@192.168.1.143 --remote-root /mnt/Main/main/poke-bot-agent/archive/crustle-guide-corpus-family-full33-v2 --destination /home/inzi/poke-bot-agent/data/bootstrap/expert-latest20-2026-07-04-2026-07-23-roster18-v6-strategic/crustle-v2 --specialist-id crustle --guide-version crustle-north-star-v2 --receipt /home/inzi/poke-bot-agent/outputs/state/crustle-prestage-corpus-import-v2.json --bwlimit-kib 8000 --minimum-records 16639 --finalization-receipt-name CRUSTLE_GUIDE_CORPUS_VALIDATED.json --finalization-receipt-schema poke_bot.crustle_guide_corpus_validation/v1
TimeoutStartSec=2h
Nice=15
IOSchedulingClass=idle
CPUWeight=5
MemoryHigh=4G
MemoryMax=8G
