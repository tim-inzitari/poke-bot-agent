[Unit]
Description=Crustle family full33 v2 guide corpus rebind
After=pokebot-crustle-full33-catalog-v1.service
ConditionPathExists=/mnt/Main/main/poke-bot-agent/archive/crustle-public-family-full33-v1.json
OnSuccess=pokebot-crustle-full33-label-audit-v1.service

[Service]
Type=oneshot
User=admin
Group=admin
WorkingDirectory=/home/admin/pokebot-expert-guide-src-v1
Environment=POKEBOT_CRUSTLE_TEACHER_SHA256=e3f7d0cccd541c6b0031b5e67d6a283dd642a85734bb4325eca9147bde7fa28e
Environment=POKEBOT_CRUSTLE_DAY_PARALLELISM=2
Environment=POKEBOT_CRUSTLE_WORKERS_PER_DAY=2
Environment=POKEBOT_CRUSTLE_MAX_IN_FLIGHT_PER_DAY=4
ExecStart=/usr/bin/bash /home/admin/pokebot-expert-guide-src-v1/ops/elmo/build_crustle_full33_corpus.sh
Nice=15
IOSchedulingClass=idle
CPUQuota=400%
MemoryHigh=12G
MemoryMax=16G
TimeoutStartSec=infinity

[Install]
WantedBy=multi-user.target
