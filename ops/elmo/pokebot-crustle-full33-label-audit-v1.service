[Unit]
Description=Crustle family full33 v2 guide-label audit
After=pokebot-crustle-full33-corpus-v1.service
ConditionPathExists=/mnt/Main/main/poke-bot-agent/archive/crustle-guide-corpus-family-full33-v2/CURRENT_DECK_GUIDE_CORPUS_READY.json

[Service]
Type=oneshot
User=admin
Group=admin
WorkingDirectory=/home/admin/pokebot-expert-guide-src-v1
ExecStart=/usr/bin/bash /home/admin/pokebot-expert-guide-src-v1/ops/elmo/audit_crustle_full33_labels.sh
Nice=15
IOSchedulingClass=idle
CPUQuota=400%
MemoryHigh=12G
MemoryMax=16G
TimeoutStartSec=infinity
