[Unit]
Description=Finite RTX 3080 Ti official Basic Energy Attach parity gate (OUT OF FLEET)
After=default.target

[Service]
Type=oneshot
WorkingDirectory=/home/pokebot/poke-bot-agent-remote-cutover
Environment=CG_LIB_PATH=/home/pokebot/poke-bot-agent/kaggle/input/pokemon-tcg-ai-battle/sample_submission/sample_submission
Environment=PYTHONPATH=/home/pokebot/poke-bot-agent-remote-cutover
Environment=CUDA_DEVICE_ORDER=PCI_BUS_ID
Environment=CUDA_VISIBLE_DEVICES=GPU-72bf89ff-6e52-01d4-a49b-90a7addfd632
ExecStartPre=/home/pokebot/miniconda3/envs/poke-bot-agent/bin/python /home/pokebot/cuda-sim-lab/official_basic_energy_attach_collect.py --deck /home/pokebot/cuda-sim-lab/official_basic_energy_attach_deck.csv --official-lib /home/pokebot/poke-bot-agent/kaggle/input/pokemon-tcg-ai-battle/sample_submission/sample_submission/cg/libcg.so --json-out /home/pokebot/cuda-sim-lab/outputs/official-basic-energy-attach-fixtures.json --fixtures 256 --max-games 128 --max-steps 256
ExecStart=/home/pokebot/miniconda3/envs/poke-bot-agent/bin/python /home/pokebot/cuda-sim-lab/official_basic_energy_attach_cuda.py --fixtures /home/pokebot/cuda-sim-lab/outputs/official-basic-energy-attach-fixtures.json --json-out /home/pokebot/cuda-sim-lab/outputs/official-basic-energy-attach-cuda.json --benchmark-lanes 65536 --benchmark-iters 50
TimeoutStartSec=300
MemoryHigh=6G
MemoryMax=8G
CPUQuota=200%
CPUWeight=50
IOWeight=50
StandardOutput=append:/home/pokebot/cuda-sim-lab/outputs/official-basic-energy-attach-once.log
StandardError=append:/home/pokebot/cuda-sim-lab/outputs/official-basic-energy-attach-once.log

# Deliberately no installation section: this parity gate must be invoked manually
# and can never become an enabled/restarting background loop.
