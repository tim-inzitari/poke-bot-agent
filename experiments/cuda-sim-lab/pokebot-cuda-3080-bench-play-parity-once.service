[Unit]
Description=Finite RTX 3080 Ti official Basic Bench Play parity gate (OUT OF FLEET)
After=default.target

[Service]
Type=oneshot
WorkingDirectory=/home/pokebot/poke-bot-agent-remote-cutover
Environment=CG_LIB_PATH=/home/pokebot/poke-bot-agent/kaggle/input/pokemon-tcg-ai-battle/sample_submission/sample_submission
Environment=PYTHONPATH=/home/pokebot/poke-bot-agent-remote-cutover
Environment=CUDA_DEVICE_ORDER=PCI_BUS_ID
Environment=CUDA_VISIBLE_DEVICES=GPU-72bf89ff-6e52-01d4-a49b-90a7addfd632
ExecStartPre=/home/pokebot/miniconda3/envs/poke-bot-agent/bin/python /home/pokebot/cuda-sim-lab/official_basic_bench_play_collect.py --deck /home/pokebot/cuda-sim-lab/official_basic_energy_attach_deck.csv --official-lib /home/pokebot/poke-bot-agent/kaggle/input/pokemon-tcg-ai-battle/sample_submission/sample_submission/cg/libcg.so --json-out /home/pokebot/cuda-sim-lab/outputs/official-basic-bench-play-fixtures.json --fixtures 256 --max-games 2048 --max-steps 256
ExecStart=/home/pokebot/miniconda3/envs/poke-bot-agent/bin/python /home/pokebot/cuda-sim-lab/official_basic_bench_play_cuda.py --fixtures /home/pokebot/cuda-sim-lab/outputs/official-basic-bench-play-fixtures.json --json-out /home/pokebot/cuda-sim-lab/outputs/official-basic-bench-play-cuda.json --benchmark-lanes 16384 --benchmark-iters 25
TimeoutStartSec=300
MemoryHigh=6G
MemoryMax=8G
CPUQuota=200%
CPUWeight=50
IOWeight=50
StandardOutput=append:/home/pokebot/cuda-sim-lab/outputs/official-basic-bench-play-once.log
StandardError=append:/home/pokebot/cuda-sim-lab/outputs/official-basic-bench-play-once.log

# Deliberately no installation section or restart policy.
