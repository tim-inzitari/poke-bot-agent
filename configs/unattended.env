# Shared tuning for unattended multi-day runs. Sourced by scripts/run_unattended.sh
# (with `set -a`, so every KEY=VALUE is exported). These keys map to poke_agent/config.py
# via _ENV_MAP. Per-archetype overrides live in configs/unattended.<archetype>.env and are
# sourced AFTER this file, so they win.

# --- Critic / search-improved value (Sprint A) ---
OBJECTIVE_SEARCH_VALUE_BLEND=0.5   # value_target = (1-b)*MC + b*search_value; no-op on rows without search_value
LOSS_VALUE_WEIGHT=0.75             # emphasize the critic (PDF: value loss weight 0.5-1.0)
SEARCH_DETERMINIZATIONS=6          # belief samples per searched action (PDF default; was 2)

# --- Self-play loop pacing for long unattended runs ---
SELF_PLAY_TRAIN_EPOCHS=64          # per-iteration epochs (config default 500 is too slow for 512d)
SELF_PLAY_ITERATIONS=500           # per-segment iteration budget; auto-continues when exhausted
SELF_PLAY_PLATEAU_PATIENCE=8         # stop segment after N flat evals, then continue segment
SELF_PLAY_OPPONENT_LATEST_PROB=0.4 # more historical opponents -> more diversity (PDF: robustness)
SELF_PLAY_BASELINE_WIN_RATE=0.50   # aggregate gate vs official agents before transformer phase

# --- Unattended launcher: crash retry + multi-segment continuation ---
UNATTENDED_LOOP=1
UNATTENDED_MAX_CYCLES=100          # up to 100 segments x 500 iters if each finishes early
UNATTENDED_MAX_RETRIES=3
UNATTENDED_RETRY_SLEEP_SEC=60

# --- Disk retention (watchdog runs prune_disk_unattended.sh every 6h) ---
PRUNE_INTERVAL_SEC=21600            # 6 hours
KEEP_CACHE=2                        # orphan tensor-hash caches at outputs/cache/training_tensors/
KEEP_NAMED_CACHE=1                  # per lucario_fresh/ dragapult_fresh/ nested hashes
KEEP_CKPT=8                         # baseline_/iter_ checkpoints per archetype
PRUNE_MIN_AGE_SEC=7200              # never delete artifacts touched in the last 2h
