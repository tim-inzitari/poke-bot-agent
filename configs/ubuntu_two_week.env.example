# Ubuntu unattended runner defaults for a 7950X + 128GB RAM + 48GB/12GB CUDA box.
# Copy to configs/ubuntu_two_week.env and edit there.

# Wall-clock budget. The runner finishes the current iteration before stopping.
RUN_HOURS=336

# GPU selection. Default code picks the largest visible CUDA GPU, usually the 48GB RTX 5000.
POKE_AGENT_SELECT_LARGEST_CUDA=1
# POKE_AGENT_CUDA_DEVICE=1
# CUDA_VISIBLE_DEVICES=1
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
CUDA_DEVICE_ORDER=PCI_BUS_ID

# CPU/data loading. 7950X has 32 threads; keep a few free for the OS and nvidia driver.
TENSOR_BUILD_WORKERS=28
BOOTSTRAP_WORKERS=28
OMP_NUM_THREADS=16
MKL_NUM_THREADS=16

# Bootstrap from scratch if no checkpoint exists.
BOOTSTRAP_IF_NEEDED=1
BOOTSTRAP_GAMES=20000
BOOTSTRAP_ROLLOUTS=data/ubuntu_bootstrap_rollouts.jsonl
BOOTSTRAP_MERGED=data/ubuntu_training_rollouts_merged.jsonl
BOOTSTRAP_TRAIN_EPOCHS=200

# Model/training. Batch 8 is the conservative 48GB default for the current KAN + window=256 model.
MODEL_OUTPUT_PATH=outputs/checkpoints/temporal_current.pt
WINDOW_SIZE=256
BATCH_GAMES=8
TRAIN_EPOCHS=100
SELF_PLAY_TRAIN_EPOCHS=100
EARLY_STOP_PATIENCE=5
EARLY_STOP_MIN_DELTA=0.01

# Self-play loop. Keep stop criteria high so the two-week process does not exit early.
SELF_PLAY_GAMES=250
SELF_PLAY_EVAL_GAMES=50
SELF_PLAY_ITERATIONS=100000
SELF_PLAY_OPPONENT_POOL_SIZE=8
SELF_PLAY_OUTPUT_PATH=outputs/rollouts/ubuntu_long_run.jsonl
SELF_PLAY_CHECKPOINT_DIR=outputs/checkpoints/ubuntu_long_run
SELF_PLAY_BASELINES=public
SELF_PLAY_TRAIN_VS_BASELINES=1
SELF_PLAY_USE_BEAM=1
SELF_PLAY_TARGET_WIN_RATE=0.99
SELF_PLAY_PLATEAU_PATIENCE=100000

# Safety/retry behavior.
MAX_CONSECUTIVE_FAILURES=20
FAILURE_SLEEP_SECONDS=300
BUILD_SUBMISSION_EACH_ITER=1
AUTO_DOWNLOAD_KAGGLE_INPUTS=1
