[Unit]
Description=Build and audit inactive public matchup router v35 after simulator evidence
Wants=network-online.target
After=network-online.target pokebot-router-calibration-v35-sim.service
StartLimitIntervalSec=0

[Service]
Type=oneshot
WorkingDirectory=/mnt/Main/main/poke-adapter-oracle-v29
ExecStartPre=/usr/bin/mkdir -p /mnt/Main/main/poke-adapter-oracle-v29/output/public-matchup-tree-calibration-v35
ExecStartPre=/bin/sh -c 'while ! /usr/bin/test -s /mnt/Main/main/poke-bot-agent/archive/router-calibration-v35/router-calibration-v35.zip; do /usr/bin/sleep 30; done'
ExecStart=/usr/bin/python3 /mnt/Main/main/poke-adapter-oracle-v29/src/scripts/retrain_public_matchup_tree_elmo_v35.py
ExecStartPost=/usr/bin/python3 /mnt/Main/main/poke-adapter-oracle-v29/src/scripts/audit_public_matchup_tree_candidate.py --artifact /mnt/Main/main/poke-adapter-oracle-v29/output/public-matchup-tree-calibration-v35/public-matchup-tree.json --minimum-precision 0.93 --minimum-weighted-support 10000 --output /mnt/Main/main/poke-adapter-oracle-v29/output/public-matchup-tree-calibration-v35/public-matchup-tree.audit.json
Restart=on-failure
RestartSec=60
TimeoutStartSec=36h
KillMode=control-group
LimitNOFILE=16384
MemoryHigh=24G
MemoryMax=32G
OOMPolicy=stop
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
