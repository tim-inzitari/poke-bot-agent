[Unit]
Description=Train revision-116 Marnie latent-lookahead shadow challenger
After=pokebot-marnie-latent-lookahead-r114-stage.service
ConditionPathExists=/home/inzi/poke-bot-agent/outputs/state/final-format-marnie-r104-latent-lookahead-r114-stage.json
ConditionPathExists=!/home/inzi/poke-bot-agent/outputs/state/final-format-marnie-r104-latent-lookahead-r116-shadow-train.json

[Service]
Type=oneshot
WorkingDirectory=/home/inzi/poke-bot-agent
Environment=PYTHONPATH=/home/inzi/poke-bot-agent
Environment=OMP_NUM_THREADS=4
Environment=MKL_NUM_THREADS=4
Nice=15
CPUWeight=10
IOWeight=10
ExecStart=/home/inzi/miniconda3/envs/poke-bot-agent/bin/python -u scripts/train_marnie_latent_lookahead_r116.py --commit /home/inzi/poke-bot-agent/outputs/pure_rl/final_format_marnie_r104_h10_i_v6_8k/commits/iter_00005.json --stage-receipt /home/inzi/poke-bot-agent/outputs/state/final-format-marnie-r104-latent-lookahead-r114-stage.json --collection-receipt /home/inzi/poke-bot-agent/outputs/pure_rl/final_format_marnie_r104_h10_i_v6_8k/collection_receipts/iter_00005.json --shard /home/inzi/poke-bot-agent/outputs/pure_rl/final_format_marnie_r104_h10_i_v6_8k/shards/iter_00005.jsonl --input /home/inzi/poke-bot-agent/outputs/pure_rl/_protected/challengers/marnie-latent-lookahead-r114-shadow/model.pt --output /home/inzi/poke-bot-agent/outputs/pure_rl/_protected/challengers/marnie-latent-lookahead-r116-trained-shadow/model.pt --receipt /home/inzi/poke-bot-agent/outputs/state/final-format-marnie-r104-latent-lookahead-r116-shadow-train.json --device cpu --threads 4 --max-games 256 --batch-games 2 --epochs 1 --learning-rate 0.0001

[Install]
