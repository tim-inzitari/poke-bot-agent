[Service]
Type=oneshot
User=admin
WorkingDirectory=/home/admin/pokebot-expert-guide-src-v1
ExecStart=/usr/bin/python3 scripts/finalize_current_deck_guide_window.py --status /mnt/Main/main/poke-bot-agent/archive/expert-latest20-derived/daily/current-deck-guides-v1/thwackey/status/window.json --out-dir /mnt/Main/main/poke-bot-agent/archive/expert-latest20-derived/daily/current-deck-guides-v1/thwackey --start 2026-07-04 --end 2026-07-23 --specialist-id thwackey --guide-version thwackey-festival-lead-north-star-v1 --expected-max-context 320
CPUQuota=400%
MemoryMax=8G
