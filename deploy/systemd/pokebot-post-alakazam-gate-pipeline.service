[Unit]
Description=Verified Alakazam pass to protected core and staged Trevenant RL
Wants=network-online.target
After=network-online.target
# The exact gate may pass before the protected latest-10 corpora finish.
# Keep retrying the fail-closed handoff instead of exhausting a finite burst
# while those immutable inputs are still being materialized.
StartLimitIntervalSec=0

[Service]
Type=oneshot
WorkingDirectory=/home/inzi/poke-bot-agent-deployments/pure-rl-resident-v31-matchup-runtime
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/home/inzi/poke-bot-agent-deployments/pure-rl-resident-v31-matchup-runtime
Environment=CUDA_DEVICE_ORDER=PCI_BUS_ID
Environment=CUDA_VISIBLE_DEVICES=1
Environment=PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
ExecStartPre=/usr/bin/test -s /home/inzi/poke-bot-agent-deployments/pure-rl-resident-v31-matchup-runtime/ops/post_alakazam_starmie_handoff_v1.json
ExecStartPre=/usr/bin/test -s /home/inzi/poke-bot-agent/outputs/state/alakazam-protocol-passed-gate-handler-v31.json
ExecStartPre=/usr/bin/test -s /home/inzi/poke-bot-agent/outputs/pure_rl/_protected/models/alakazam-protocol-gate-pass-v1/manifest.json
ExecStartPre=/usr/bin/test -s /home/inzi/poke-bot-agent/outputs/pure_rl/_protected/models/alakazam-protocol-gate-pass-v1/PROTECTED_DO_NOT_PRUNE.json
ExecStartPre=/usr/bin/test -s /home/inzi/poke-bot-agent/outputs/pure_rl/_protected/models/alakazam-protocol-gate-pass-v1/model.pt
ExecStartPre=/usr/bin/test -s /home/inzi/poke-bot-agent/data/bootstrap/expert-latest20-20260702-20260721/hops-trevenant-v2/PROTECTED_EXPERT_CORPUS.json
ExecStart=/home/inzi/miniconda3/envs/poke-bot-agent/bin/python -u scripts/run_post_alakazam_starmie_handoff.py run --contract /home/inzi/poke-bot-agent-deployments/pure-rl-resident-v31-matchup-runtime/ops/post_alakazam_starmie_handoff_v1.json
Restart=on-failure
RestartSec=300
TimeoutStartSec=36h
TimeoutStopSec=90
KillMode=control-group
LimitNOFILE=16384
MemoryHigh=96G
MemoryMax=112G
MemorySwapMax=0
OOMPolicy=stop
StandardOutput=append:/home/inzi/poke-bot-agent/outputs/logs/post-alakazam-specialist-handoff-v2.log
StandardError=append:/home/inzi/poke-bot-agent/outputs/logs/post-alakazam-specialist-handoff-v2.log
