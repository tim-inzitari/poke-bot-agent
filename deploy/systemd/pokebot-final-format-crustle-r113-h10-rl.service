[Unit]
Description=Final-format Crustle H10-I Fusion-v3 Router-6 RL
After=pokebot-final-format-crustle-r113-h10-register.service network-online.target
Wants=network-online.target
ConditionPathExists=/home/inzi/poke-bot-agent/outputs/final_format_crustle_r113/runtime/specialist_runtime_registry_h10_r113.json
OnSuccess=pokebot-final-format-crustle-r113-h10-gate-handler.service
StartLimitIntervalSec=900
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=/home/inzi/poke-bot-agent-deployments/final-format-marnie-h10-r104
EnvironmentFile=/home/inzi/poke-bot-agent/outputs/final_format_crustle_r113/runtime/specialist_runtime_h10_r113.env
EnvironmentFile=/home/inzi/poke-bot-agent-deployments/final-format-marnie-h10-r104/config/final_format_marnie_h10_runtime.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/home/inzi/poke-bot-agent:/home/inzi/poke-bot-agent-deployments/final-format-marnie-h10-r104
Environment=POKEBOT_CURRENT_DECK_GUIDE=crustle
Environment=POKEBOT_CURRENT_DECK_GUIDE_VERSION=crustle-north-star-v2
Environment=POKEBOT_COMBO_STATE_HEAD_ENABLED=1
Environment=POKEBOT_RELEASE_LOCAL_POOL_BEFORE_RESULT_DRAIN=1
Environment=PURE_RL_SIM_WORKERS=96
Environment=PURE_RL_GAMES_IN_FLIGHT=96
Environment=PURE_RL_HELDOUT_LOCAL_WORKERS=96
Environment=PURE_RL_REBALANCE_MIN_WORKERS=96
Environment=PURE_RL_REBALANCE_MAX_WORKERS=96
Environment=POKEBOT_LIVE_POOL_MAX_WORKERS=96
ExecStartPre=/usr/bin/test -s /home/inzi/poke-bot-agent/outputs/state/TRAINING_ARMED
ExecStartPre=/home/inzi/miniconda3/envs/poke-bot-agent/bin/python -u /home/inzi/poke-bot-agent/scripts/launch_active_specialist.py --registry /home/inzi/poke-bot-agent/outputs/final_format_crustle_r113/runtime/specialist_runtime_registry_h10_r113.json --check
ExecStartPre=/home/inzi/miniconda3/envs/poke-bot-agent/bin/python -u /home/inzi/poke-bot-agent/scripts/launch_active_specialist_gate_handler.py --registry /home/inzi/poke-bot-agent/outputs/final_format_crustle_r113/runtime/specialist_runtime_registry_h10_r113.json --check
ExecStartPre=/home/inzi/miniconda3/envs/poke-bot-agent/bin/python -u /home/inzi/poke-bot-agent/scripts/complete_post_marnie_crustle_h10.py --check --handler-state /home/inzi/poke-bot-agent/outputs/state/crustle-passed-gate-handler-v1.json --bootstrap-ready /home/inzi/poke-bot-agent/outputs/state/final-format-crustle-r113-h10-bootstrap-ready.json --runtime-registry /home/inzi/poke-bot-agent/outputs/final_format_crustle_r113/runtime/specialist_runtime_registry_h10_r113.json --protocol /home/inzi/poke-bot-agent/config/rl_protocol.yaml --specialist-state /home/inzi/poke-bot-agent/state/specialists.yaml --refresh-registry /home/inzi/poke-bot-agent/outputs/state/post-fleet-refresh-registry-v1.json --completion-receipt /home/inzi/poke-bot-agent/outputs/state/final-format-crustle-r113-h10-completion-v1.json --next-service pokebot-post-refresh-capacity-boundary-r104.service --next-unit /home/inzi/.config/systemd/user/pokebot-post-refresh-capacity-boundary-r104.service
ExecStart=/home/inzi/miniconda3/envs/poke-bot-agent/bin/python -u /home/inzi/poke-bot-agent/scripts/launch_active_specialist.py --registry /home/inzi/poke-bot-agent/outputs/final_format_crustle_r113/runtime/specialist_runtime_registry_h10_r113.json
Restart=on-failure
RestartSec=60
RestartPreventExitStatus=75 78
TimeoutStopSec=45
KillMode=control-group
LimitNOFILE=16384
MemoryHigh=96G
MemoryMax=112G
MemorySwapMax=0
OOMPolicy=stop
StandardOutput=append:/home/inzi/poke-bot-agent/outputs/final_format_crustle_r113/logs/rl.log
StandardError=append:/home/inzi/poke-bot-agent/outputs/final_format_crustle_r113/logs/rl.log

