After=pokebot-final-format-alakazam-rtp-r175-rl.service
ConditionPathExists=/home/inzi/poke-bot-agent-deployments/final-format-alakazam-marnie-splusplus-r192/runtime/alakazam-marnie-splusplus-r192-stage.json

[Service]
Type=oneshot
WorkingDirectory=/home/inzi/poke-bot-agent
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/inzi/miniconda3/envs/poke-bot-agent/bin/python -u scripts/pause_at_committed_iteration.py --run-dir /home/inzi/poke-bot-agent/outputs/pure_rl/final_format_alakazam_rtp_r175_i_v6_8k --unit pokebot-final-format-alakazam-rtp-r175-rl.service --completed-iteration 16 --status /home/inzi/poke-bot-agent/outputs/state/alakazam-marnie-splusplus-r192-inactive-boundary.json --poll-seconds 0.10 --timeout-seconds 172800
