[Unit]
Description=Alakazam RTP owner hard-swap overnight orchestrator (r175)
After=network-online.target
Wants=network-online.target
Conflicts=pokebot-final-format-slop-box-h10-rtp-bootstrap.service pokebot-final-format-alakazam-r79-h10.service

[Service]
Type=oneshot
WorkingDirectory=/home/inzi/poke-bot-agent
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/home/inzi/poke-bot-agent
Environment=POKEBOT_COMBO_STATE_HEAD_ENABLED=1
Environment=POKEBOT_COMBO_STATE_ROUTE_ENABLED=0
Environment=POKEBOT_COMBO_STATE_ROUTE_SPECIALIST=alakazam
Environment=POKEBOT_SETUP_BOARD_OUTCOME_HEAD_ENABLED=1
Environment=POKEBOT_EXPANDED_HEADS_ENABLED=1
Environment=POKEBOT_DECISION_FUSION_ENABLED=1
Environment=POKEBOT_H10_CAPACITY_ENABLED=1
ExecStartPre=/usr/bin/test -s /home/inzi/poke-bot-agent/decks/archetype-samples/alakazam-owner-rtp-pilot-r175.csv
ExecStartPre=/usr/bin/test -s /home/inzi/poke-bot-agent/outputs/pure_rl/final_format_alakazam_r79_h10_i_v6_8k/checkpoints/iter_00020.pt
ExecStartPre=/usr/bin/test -s /home/inzi/poke-bot-agent/outputs/pure_rl/final_format_marnie_r104_h10_i_v6_8k/checkpoints/iter_00007.pt
ExecStart=/home/inzi/miniconda3/envs/poke-bot-agent/bin/python -u /home/inzi/poke-bot-agent/scripts/run_alakazam_rtp_overnight_r175.py
Restart=no
TimeoutStartSec=infinity
MemoryHigh=96G
MemoryMax=112G
MemorySwapMax=0
StandardOutput=append:/home/inzi/poke-bot-agent/outputs/final_format_alakazam_rtp_r175/logs/overnight-orchestrator.log
StandardError=append:/home/inzi/poke-bot-agent/outputs/final_format_alakazam_rtp_r175/logs/overnight-orchestrator.log

[Install]
WantedBy=default.target
