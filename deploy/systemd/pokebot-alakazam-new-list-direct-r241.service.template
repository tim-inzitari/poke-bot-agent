# Inert template: do not install, enable, or start before every r241 gate and
# the immutable create-only activation overlay have been independently sealed.
# This is intentionally a new lineage-local unit, not a drop-in for an older
# trainer or the shared submission queue.

[Unit]
Description=Pokemon Alakazam new-list direct-policy r241 fixed ten-update trainer
OnSuccess=pokebot-alakazam-new-list-direct-r241-finalize.service

[Service]
Type=exec
WorkingDirectory=/
EnvironmentFile=/etc/pokebot/alakazam-new-list-direct-r241-inzi-activation.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONPATH=
Environment=CG_LIB_PATH=
Environment=POKEBOT_LIBCG_PATH=
Environment=POKEBOT_BATCH_LIBCG=
Environment=POKEBOT_ALLOW_ORACLE_DECK=
Environment=POKEBOT_BASELINES_DIR=
ExecStartPre=/bin/sh -ec 'test -n "$R241_INZI_RUNTIME_REGISTRY"; exec "$R241_INZI_PYTHON" -u "$R241_INZI_SOURCE_SNAPSHOT_ROOT/scripts/preflight_alakazam_new_list_direct_r241_service_chain.py" --stage trainer --overlay "$R241_INZI_ACTIVATION_OVERLAY" --overlay-sha256 "$R241_INZI_ACTIVATION_OVERLAY_SHA256" --overlay-mirror-receipt "$R241_INZI_ACTIVATION_OVERLAY_MIRROR_RECEIPT" --overlay-mirror-receipt-sha256 "$R241_INZI_ACTIVATION_OVERLAY_MIRROR_RECEIPT_SHA256"'
ExecStartPre=/bin/sh -ec 'exec "$R241_INZI_PYTHON" -u "$R241_INZI_SOURCE_SNAPSHOT_ROOT/scripts/launch_alakazam_new_list_direct_r241.py" --registry "$R241_INZI_RUNTIME_REGISTRY" --host inzi --python "$R241_INZI_PYTHON" --activation-overlay "$R241_INZI_ACTIVATION_OVERLAY" --activation-overlay-sha256 "$R241_INZI_ACTIVATION_OVERLAY_SHA256" --activation-overlay-mirror-receipt "$R241_INZI_ACTIVATION_OVERLAY_MIRROR_RECEIPT" --activation-overlay-mirror-receipt-sha256 "$R241_INZI_ACTIVATION_OVERLAY_MIRROR_RECEIPT_SHA256" --check'
ExecStart=/bin/sh -ec 'exec "$R241_INZI_PYTHON" -u "$R241_INZI_SOURCE_SNAPSHOT_ROOT/scripts/launch_alakazam_new_list_direct_r241.py" --registry "$R241_INZI_RUNTIME_REGISTRY" --host inzi --python "$R241_INZI_PYTHON" --activation-overlay "$R241_INZI_ACTIVATION_OVERLAY" --activation-overlay-sha256 "$R241_INZI_ACTIVATION_OVERLAY_SHA256" --activation-overlay-mirror-receipt "$R241_INZI_ACTIVATION_OVERLAY_MIRROR_RECEIPT" --activation-overlay-mirror-receipt-sha256 "$R241_INZI_ACTIVATION_OVERLAY_MIRROR_RECEIPT_SHA256" --execute'
Restart=no
TimeoutStartSec=infinity
TimeoutStopSec=900
