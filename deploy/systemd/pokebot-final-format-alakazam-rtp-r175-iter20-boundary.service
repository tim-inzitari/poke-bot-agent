RestartSec=30
MemoryHigh=512M
MemoryMax=1G
StandardOutput=append:/home/inzi/poke-bot-agent/outputs/final_format_alakazam_rtp_r175/logs/iter20_boundary.log
StandardError=append:/home/inzi/poke-bot-agent/outputs/final_format_alakazam_rtp_r175/logs/iter20_boundary.log
