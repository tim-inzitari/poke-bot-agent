Environment="POKEBOT_TRUENAS_CHECKPOINT_SMB=/run/user/1000/gvfs/smb-share:server=192.168.1.143,share=main,user=inzi/poke-bot-agent/containers/truenas-worker/checkpoint"
ExecStartPre=/usr/bin/test -d /run/user/1000/gvfs/smb-share:server=192.168.1.143,share=main,user=inzi/poke-bot-agent/containers/truenas-worker/checkpoint
ExecStartPre=/usr/bin/test -s /home/inzi/poke-bot-agent/outputs/engines/libcg_hidden_inzi_v1.so
# Three overnight 20,480-decision batches exhausted all but 10-23 MiB of the
# 48 GiB Blackwell and poisoned the CUDA context after allocator map failures.
# Keep the 240-game grouping but cap decision activations 40% lower, preserving
# the resident replay corpus while leaving several GiB of deterministic headroom.
ExecStart=/home/inzi/miniconda3/envs/poke-bot-agent/bin/python -u scripts/launch_pure_rl.py --run-name pure_rl_core_baseline50_v7_20260720 --mode core --python /home/inzi/miniconda3/envs/poke-bot-agent/bin/python --preflight-profile none --allow-single-gpu --multi-env-per-worker 4 --stall-minutes 20 --log outputs/logs/pure_rl_core_baseline50_v7_20260720.log -- --initial-replay-shard /home/inzi/poke-bot-agent/outputs/pure_rl/pure_rl_core_continuous_rehearsal_v1_20260719/shards/iter_00000.jsonl --base-checkpoint /home/inzi/poke-bot-agent/outputs/pure_rl/pure_rl_core_continuous_rehearsal_v6_20260719/checkpoints/iter_00026.pt --initial-learner-checkpoint /home/inzi/poke-bot-agent/outputs/pure_rl/pure_rl_core_continuous_rehearsal_v6_20260719/checkpoints/iter_00026.pt --initial-replay-shard /home/inzi/poke-bot-agent/outputs/pure_rl/pure_rl_core_continuous_rehearsal_v6_20260719/shards/iter_00027.jsonl --archetype-aux-loss-weight 0.05 --opp-hand-loss-weight 0.05 --opp-remainder-loss-weight 0.05 --lethal-threat-loss-weight 0.025 --prize-race-loss-weight 0.025 --iterations 1000 --games-per-iter 8192 --train-epochs 2 --train-games-per-batch 240 --train-max-decisions-per-batch 12288 --heldout-games 1000 --heldout-remotes --promotion-games 80 --game-timeout-s 600 --min-usable-game-frac 0.98 --remote-worker-endpoints 192.168.1.143:8765,bert.local:8766 --expert-rehearsal-every 5 --expert-manifest /home/inzi/poke-bot-agent/data/bootstrap/latest10-20260709-20260718/manifest.json --expert-rehearsal-epochs 5 --expert-rehearsal-batch-size 8192 --expert-min-decisions 5000000 --continuous-learner-min-wr 0.35 --artifact-history-iterations 5 --min-free-disk-gb 100 --resume auto
Restart=on-failure
RestartSec=60
RestartPreventExitStatus=75 78
TimeoutStopSec=45
KillMode=control-group
LimitNOFILE=16384
MemoryHigh=96G
MemoryMax=112G
MemorySwapMax=0
OOMPolicy=stop
StandardOutput=append:/home/inzi/poke-bot-agent/outputs/logs/pure_rl_core_continuous_rehearsal_v1_20260719.launcher.log
StandardError=append:/home/inzi/poke-bot-agent/outputs/logs/pure_rl_core_continuous_rehearsal_v1_20260719.launcher.log

[Install]
