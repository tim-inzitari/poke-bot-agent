Environment=POKEBOT_ACTIVE_SPECIALIST=alakazam
Environment=POKEBOT_CURRENT_DECK_GUIDE=alakazam
Environment=POKEBOT_CURRENT_DECK_GUIDE_VERSION=powerful-hand-v1
Environment=PURE_RL_SELF_PLAY_FRAC=0.12493901903367496
Environment=PURE_RL_PUBLIC_MIX_LOCAL_ONLY=0
Environment=PURE_RL_SPATIAL_LAYERS=7
Environment=PURE_RL_TEMPORAL_LAYERS=3
Environment=PURE_RL_OPTION_DECODER_LAYERS=7
Environment=PURE_RL_FF_DIM=2496
Environment=POKEBOT_H10_CAPACITY_ENABLED=1
Environment=POKEBOT_H10_HEAD_RESIDUAL_WIDTH=512
