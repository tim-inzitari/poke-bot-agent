TimeoutStopSec=45
KillMode=control-group
LimitNOFILE=16384
MemoryHigh=96G
MemoryMax=112G
MemorySwapMax=0
OOMPolicy=stop
StandardOutput=append:/home/inzi/poke-bot-agent/outputs/final_format_alakazam_rtp_r175/logs/rl.log
StandardError=append:/home/inzi/poke-bot-agent/outputs/final_format_alakazam_rtp_r175/logs/rl.log

[Install]
WantedBy=default.target
