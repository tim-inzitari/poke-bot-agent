[Unit]
Description=Final-format Alakazam RTP RL (owner hard-swap r175)
After=network-online.target
Wants=network-online.target
ConditionPathExists=/home/inzi/poke-bot-agent/outputs/final_format_alakazam_rtp_r175/runtime/specialist_runtime_registry_h10_r175.json
ConditionPathExists=/home/inzi/poke-bot-agent/outputs/state/final-format-alakazam-rtp-r175-bootstrap-ready.json
