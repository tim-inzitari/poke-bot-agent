# Copy only after the r241 activation owner authorizes deployment.  Values are
# host-absolute because the r241 receipts reject container path remapping.
# This must be the local Docker image ID (``sha256:...``), never a mutable tag.
R241_ELMO_OFFICIAL_R236_IMAGE=REPLACE_WITH_SEALED_R241_IMAGE_ID
R241_ELMO_OFFICIAL_R236_IMAGE_ID=REPLACE_WITH_SEALED_R241_IMAGE_ID
R241_ELMO_OFFICIAL_R236_IMAGE_RECEIPT=REPLACE_WITH_ABSOLUTE_CREATE_ONLY_ELMO_WORKER_IMAGE_RECEIPT
R241_ELMO_OFFICIAL_R236_IMAGE_RECEIPT_SHA256=REPLACE_WITH_ELMO_WORKER_IMAGE_RECEIPT_SHA256
R241_ELMO_SOURCE_SNAPSHOT_ROOT=REPLACE_WITH_ABSOLUTE_IMMUTABLE_R241_SOURCE_SNAPSHOT_ROOT
# The sole container-path remap is this immutable content-addressed staging
# root -> /workspace/checkpoint.  Source and baseline paths remain identical
# host/container paths and are not inferred from this transport root.
R241_ELMO_CHECKPOINT_TRANSPORT_ROOT=REPLACE_WITH_ABSOLUTE_ELMO_CHECKPOINT_TRANSPORT_ROOT
R241_ELMO_CHECKPOINT_TRANSPORT_STAGING_RECEIPT=REPLACE_WITH_ABSOLUTE_ELMO_CHECKPOINT_TRANSPORT_STAGING_RECEIPT
R241_ELMO_CHECKPOINT_TRANSPORT_STAGING_RECEIPT_SHA256=REPLACE_WITH_CHECKPOINT_TRANSPORT_STAGING_RECEIPT_SHA256
R241_ELMO_CHECKPOINT_FILENAME=REPLACE_WITH_DIGEST_ADDRESSED_CHECKPOINT_FILENAME
R241_ELMO_LEARNER_MATCHUP_TREE_FILENAME=REPLACE_WITH_R195_E60_TREE_FILENAME
R241_ELMO_BASELINES_ROOT=REPLACE_WITH_ABSOLUTE_RECEIPT_BOUND_ELMO_BASELINE_PAYLOAD_ROOT
R241_ELMO_SOURCE_STAGING_RECEIPT=REPLACE_WITH_ABSOLUTE_ELMO_SOURCE_STAGING_RECEIPT
R241_ELMO_SOURCE_STAGING_RECEIPT_SHA256=REPLACE_WITH_SOURCE_STAGING_RECEIPT_SHA256
R241_ELMO_BASELINE_STAGING_RECEIPT=REPLACE_WITH_ABSOLUTE_ELMO_BASELINE_STAGING_RECEIPT
R241_ELMO_BASELINE_STAGING_RECEIPT_SHA256=REPLACE_WITH_BASELINE_STAGING_RECEIPT_SHA256
R241_ELMO_CANONICAL_ROSTER_RECEIPT=REPLACE_WITH_ABSOLUTE_CANONICAL_BASELINE_ROSTER_RECEIPT
R241_ELMO_CANONICAL_ROSTER_RECEIPT_SHA256=REPLACE_WITH_CANONICAL_ROSTER_RECEIPT_SHA256
# The publisher creates one logical overlay and writes byte-identical readonly
# mirrors.  Elmo's serve command consumes its local mirror with the shared SHA.
R241_ELMO_ACTIVATION_OVERLAY=REPLACE_WITH_ABSOLUTE_ELMO_ACTIVATION_OVERLAY_MIRROR
R241_ELMO_ACTIVATION_OVERLAY_SHA256=REPLACE_WITH_SHARED_ACTIVATION_OVERLAY_SHA256
R241_ELMO_SIM_WORKERS=2
R241_ELMO_SIM_DEFAULT_WORKERS=2
R241_ELMO_LEAF_SERVERS=1
R241_ELMO_LEAF_GPU=cuda:0
R241_ELMO_CPUS=2.0
R241_ELMO_MEM_LIMIT=12g
R241_ELMO_PIDS_LIMIT=256
R241_ELMO_SHM_SIZE=2gb
R241_ELMO_NVIDIA_VISIBLE_DEVICES=all
