# The operator renders equivalent values into the exact Docker invocation.
# No AWS credentials are passed into the container.
POKEBOT_REMOTE_CHECKPOINT_ROOT=/opt/pokebot/checkpoint
POKEBOT_REMOTE_ACTIVE_CHECKPOINT_FILE=/opt/pokebot/state/active-checkpoint.json
SIM_WORKERS=48
SIM_DEFAULT_WORKERS=48
ELMO_SIM_WORKER_CEILING=60
CUDA_VISIBLE_DEVICES=0

# Bind inside the host only. The CloudFormation security group has no inbound
# rules; the operator reaches this port only through Session Manager.
POKEBOT_REMOTE_BIND_HOST=0.0.0.0
POKEBOT_REMOTE_BIND_PORT=8765
